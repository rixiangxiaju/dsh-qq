{
  "name": "dsh-qq",
  "version": "0.2.0",
  "description": "QQ 桥接插件：通过 OneBot v11（NapCat / LLOneBot）让 DSH 直接在 QQ 上聊天。每个联系人一个独立会话，支持自定义人设、好感度与关系演化、QQ 小黄脸、风格表情包、颜文字、分条气泡、群聊 @、主动找人、久不回追问，以及一个零依赖的本地配置页。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "napcat",
    "llonebot",
    "chatbot",
    "persona",
    "companion"
  ],
  "author": "dsh-qq contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixiangxiaju/dsh-qq.git"
  },
  "bugs": {
    "url": "https://github.com/rixiangxiaju/dsh-qq/issues"
  },
  "homepage": "https://github.com/rixiangxiaju/dsh-qq#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-agent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  }
}
